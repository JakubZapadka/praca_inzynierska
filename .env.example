# Skopiuj ten plik jako .env i uzupełnij. Nigdy nie wrzucaj .env do repozytorium.

# --- Sklep ---
# Publiczny adres sklepu (bez ukośnika na końcu). Stripe i Gelato używają go w linkach.
SITE_URL=http://localhost:3000
# Długi losowy ciąg do podpisywania linków do plików. Wygeneruj np.: openssl rand -hex 32
APP_SECRET=

# --- Panel admina (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Model AI ---
# Model używany, dopóki nie wybierzesz innego w panelu admina.
# Dostępne: nano-banana-2.1-openrouter, nano-banana-2.1-google, nano-banana-pro-google,
#           flux2-pro-openrouter, gpt-image-2-openrouter, openrouter-custom, mock
AI_MODEL_PRESET=nano-banana-2.1-openrouter
# Klucz OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Klucz Google AI Studio (z włączonym rozliczaniem): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ile sekund czekać na jeden obraz z AI.
AI_TIMEOUT_SECONDS=180
# Ile razy na godzinę jeden adres IP może generować propozycje (chroni przed kosztami).
GENERATIONS_PER_HOUR=6

# --- Płatności Stripe (https://dashboard.stripe.com/apikeys) ---
# Bez klucza sklep pokazuje testową stronę płatności (tylko lokalnie).
STRIPE_SECRET_KEY=
# Z panelu Stripe → Developers → Webhooks (lub z `stripe listen` lokalnie).
STRIPE_WEBHOOK_SECRET=
# Testowa płatność bez Stripe także na serwerze produkcyjnym (tylko do pokazów!).
ALLOW_DEV_CHECKOUT=false

# --- Realizacja zamówień ---
# gelato = automatyczny druk i wysyłka, manual = plik do druku w panelu
FULFILLMENT_PROVIDER=manual
# Klucz z https://dashboard.gelato.com → Developer → API keys
GELATO_API_KEY=
# draft = Gelato zapisuje zamówienie jako szkic (nic nie drukuje). Po testach ustaw order.
GELATO_ORDER_TYPE=draft
GELATO_CURRENCY=PLN
# Opcjonalnie: metoda wysyłki Gelato, np. normal albo express
GELATO_SHIPMENT_METHOD=
# Losowy token; webhook Gelato ustaw na: https://twoja-domena/api/webhooks/gelato?token=TEN_TOKEN
GELATO_WEBHOOK_TOKEN=

# --- Baza danych i pliki ---
# Lokalny plik SQLite albo Turso: libsql://nazwa.turso.io (+ DATABASE_AUTH_TOKEN)
DATABASE_URL=file:./data/obrazio.db
DATABASE_AUTH_TOKEN=
# Folder na zdjęcia klientów, obrazy z AI i pliki do druku
STORAGE_DIR=./storage
